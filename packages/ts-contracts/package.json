{
  "name": "@pixelz/ts-contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --prefix ../.. --filter @pixelz/ts-game-core run build && tsc",
    "dev": "tsc --watch",
    "lint": "pnpm --prefix ../.. --filter @pixelz/ts-game-core run build && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pixelz/ts-game-core": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
