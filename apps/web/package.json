{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --prefix ../.. --filter @pixelz/shared run build && tsc -b && vite build",
    "dev": "vite",
    "lint": "pnpm --prefix ../.. --filter @pixelz/shared run build && tsc --noEmit",
    "test": "pnpm --prefix ../.. --filter @pixelz/shared run build && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pixelz/shared": "workspace:*",
    "@supabase/supabase-js": "^2.100.1",
    "idb": "^8.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.2"
  }
}
