{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --prefix ../.. --filter @pixelz/shared... run build && tsc",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@pixelz/shared": "workspace:*",
    "hono": "^4.12.9",
    "jose": "^6.2.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "dotenv": "^17.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
