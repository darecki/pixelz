{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --prefix ../.. --filter @pixelz/shared run build && tsc",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@pixelz/shared": "workspace:*",
    "hono": "^4.6.12",
    "jose": "^5.9.6",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.6"
  }
}
